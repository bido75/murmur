{
  "name": "murmur-desktop",
  "productName": "Murmur",
  "version": "0.1.0",
  "description": "Records meetings on your computer without a bot joining the call.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/shared/*.test.ts",
    "mac-helper": "bash native/macos/build.sh",
    "dist:mac": "npm run mac-helper && node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
