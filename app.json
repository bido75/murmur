{
  "expo": {
    "name": "Murmur",
    "slug": "murmur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.murmur"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.giscop.murmur"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Murmur adds photos you choose to your recordings.",
          "cameraPermission": "Murmur takes site photos during recordings and pins them to the moment they were taken.",
          "microphonePermission": "Murmur uses the microphone to record conversations you choose to capture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Murmur uses the microphone to record conversations you choose to capture.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1F6F5C"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "scheme": "murmur",
    "experiments": {
      "typedRoutes": false
    }
  }
}
