# Copy to .env and fill in. These two are safe to ship in the app (publishable/anon key only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Where the web app is deployed (optional). Enables Claude.ai / ChatGPT connector sign-in.
EXPO_PUBLIC_APP_URL=https://app.example.com

# Never put ANTHROPIC_API_KEY or DEEPGRAM_API_KEY here. They live only in
# Supabase Edge Function secrets (see README).
#
# Billing works the same way: nothing about plans, minutes or payment belongs in
# .env or in the app bundle. The app only asks the server what the plan is. The
# secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY,
# STRIPE_PRICE_YEARLY, REVENUECAT_WEBHOOK_SECRET, REVENUECAT_API_KEY,
# REVENUECAT_WEB_PURCHASE_URL) live in Supabase Edge Function secrets:
#   supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...
# The app needs no new public variable for billing.
