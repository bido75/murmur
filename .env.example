# Copy to .env and fill in. These two are safe to ship in the app (publishable/anon key only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put ANTHROPIC_API_KEY or DEEPGRAM_API_KEY here. They live only in
# Supabase Edge Function secrets (see README).
